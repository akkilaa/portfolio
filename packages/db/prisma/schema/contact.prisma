model ContactSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @db.Citext
  message   String
  ip        String?  @db.Inet
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("contact_submissions")
}
