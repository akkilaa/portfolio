{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Portfolio API – Posts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List published posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts"]
        }
      },
      "response": []
    },
    {
      "name": "List published posts (paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts?limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts"],
          "query": [
            { "key": "limit", "value": "5" },
            { "key": "cursor", "value": "", "disabled": true }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get post by slug",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts/your-post-slug",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts", "your-post-slug"]
        }
      },
      "response": []
    },
    {
      "name": "Create post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"slug\": \"my-new-post\",\n  \"title\": \"My New Post\",\n  \"excerpt\": \"A short description\",\n  \"contentMd\": \"# Hello World\",\n  \"authorId\": \"author-1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/posts",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts"]
        }
      },
      "response": []
    },
    {
      "name": "Publish post",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts/{{postId}}/publish",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts", "{{postId}}", "publish"]
        }
      },
      "response": []
    },
    {
      "name": "Unpublish post",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts/{{postId}}/unpublish",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts", "{{postId}}", "unpublish"]
        }
      },
      "response": []
    },
    {
      "name": "Delete post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/posts/{{postId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "posts", "{{postId}}"]
        }
      },
      "response": []
    }
  ]
}
