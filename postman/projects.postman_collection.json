{
  "info": {
    "name": "Projects",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "projectId",
      "value": "1"
    },
    {
      "key": "projectSlug",
      "value": "my-project"
    }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List published projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects"]
            }
          }
        },
        {
          "name": "List published projects (paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects?limit=10&cursor=1",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "cursor", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "List published projects (by tag)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects?tag=typescript",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects"],
              "query": [{ "key": "tag", "value": "typescript" }]
            }
          }
        },
        {
          "name": "Get featured projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/featured",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "featured"]
            }
          }
        },
        {
          "name": "Get project by slug",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectSlug}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectSlug}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List all projects",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/admin",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "admin"]
            }
          }
        },
        {
          "name": "List all projects (include deleted)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/admin?includeDeleted=true",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "admin"],
              "query": [{ "key": "includeDeleted", "value": "true" }]
            }
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/projects",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"my-project\",\n  \"title\": \"My Project\",\n  \"descriptionMd\": \"# My Project\\n\\nFull description here.\",\n  \"shortDescription\": \"A short summary of the project.\",\n  \"role\": \"Lead Developer\",\n  \"liveUrl\": \"https://example.com\",\n  \"repoUrl\": \"https://github.com/example/repo\",\n  \"featured\": false,\n  \"displayOrder\": 0\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update project",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"shortDescription\": \"Updated short description.\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Publish project",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectId}}", "publish"]
            }
          }
        },
        {
          "name": "Unpublish project",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectId}}/unpublish",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectId}}", "unpublish"]
            }
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectId}}"]
            }
          }
        },
        {
          "name": "Restore project",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/v1/projects/{{projectId}}/restore",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "projects", "{{projectId}}", "restore"]
            }
          }
        }
      ]
    }
  ]
}
