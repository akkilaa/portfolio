{
  "info": {
    "name": "Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "magicLinkToken",
      "value": "<token from magic link email>"
    }
  ],
  "item": [
    {
      "name": "Login (request magic link)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "login"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"yourpassword\"\n}",
          "options": { "raw": { "language": "json" } }
        }
      }
    },
    {
      "name": "Verify magic link (sets cookies)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/v1/auth/verify?token={{magicLinkToken}}",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "verify"],
          "query": [{ "key": "token", "value": "{{magicLinkToken}}" }]
        }
      }
    },
    {
      "name": "Refresh access token",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/v1/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "refresh"]
        }
      }
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/v1/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "auth", "logout"]
        }
      }
    }
  ]
}
