DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=changeme

# Full connection string for Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}

# Media / image storage
# STORAGE_DRIVER selects the storage adapter: "local" (self-hosted disk) today,
# "s3" (Cloudflare R2 / AWS S3) later — no other code changes required.
STORAGE_DRIVER=local
# Where the local-disk adapter writes objects (a Docker volume in production).
MEDIA_ROOT=var/media
# Base URL the stored keys resolve against. In prod this is the site/CDN origin
# that serves /media/* (Nginx now, cdn.akkila.dev once on R2).
MEDIA_BASE_URL=http://localhost:3000

# Microsoft Clarity analytics (get project ID from clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# GlitchTip error tracking (DSN from your GlitchTip project settings)
# Server-side (API + Next.js SSR)
GLITCHTIP_DSN=
# Client-side (Next.js browser bundle)
NEXT_PUBLIC_GLITCHTIP_DSN=
